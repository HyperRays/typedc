import gen;

typedef struct { int x; int y; } Point;

static Point origin = {5, 6};

gen::@describe<Point>(10);

int main(void) {
    Tagged t = {{1, 2}, 7};
    struct Pair pair = {t.value, origin};
    return describe(&t) == 20 && pair.second.y == 6 ? 0 : 1;
}

//> gen: Point with 20, first x, tag 7, origin 7
