#include <stdio.h>

// a generic function lists its type parameters in <> after its name
// and can then use them like any other type
T max_of<T>(T a, T b) {
    return a > b ? a : b;
}

void swap<T>(T* a, T* b) {
    T tmp = *a;
    *a = *b;
    *b = tmp;
}

// T does not show up in the parameters here, so it has to come from
// somewhere else (see the two calls in main)
T zero<T>(void) {
    T value = 0;
    return value;
}

int main(void) {
    // most of the time you just call the function and T is inferred
    // from the arguments, each type used gets its own c function
    printf("%d\n", max_of(3, 7));
    printf("%f\n", max_of(1.5, 2.5));

    // inference wants exactly the same type for every T, so max_of(3, 7.5)
    // is an error. You can always write the type out yourself, then the
    // arguments are converted like in a normal c call
    printf("%f\n", max_of<double>(3, 7.5));

    // T can also be inferred through pointers
    char* first = "first";
    char* second = "second";
    swap(&first, &second);
    printf("%s %s\n", first, second);

    // when the arguments say nothing about T, it is taken from the type
    // the result is assigned to, or written out explicitly
    long a = zero();
    printf("%ld %f\n", a, zero<float>());

    // a generic function with its types filled in is a normal c function,
    // so you can take a pointer to it
    int (*pick)(int, int) = max_of<int>;
    printf("%d\n", pick(1, 2));
}

