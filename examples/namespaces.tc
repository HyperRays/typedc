// Typed c code can be split into namespaces. There are two kinds:
//
// 1. The root namespace is exactly the files which you give to the
//    transpiler. The transpiler never looks at the other
//    files in the same directory, which is why every example in this folder can have
//    its own main. If you pass two of them at once (./build/main a.tc b.tc)
//    they are both in the root namespace and you get
//    "redefinition of function 'main'"
//
// 2. A directory namespace is created by an import. `import geometry;` loads
//    every .tc file directly inside of <root>/geometry/, where <root> is the
//    directory of the first file given to the transpiler (or --root <dir>).
//    All of those files share their names with each other,
//    see geometry/point.tc for the rules inside of a namespace
//
// Everything ends up in the one generated header, the namespaces only exist
// in the transpiler. Where two namespaces use the same name, the generated
// functions get the name of their file prepended (see the two `area`s below)
//
// ./build/main examples/namespaces.tc | cc -std=c11 -x c - -o build/namespaces

#include <stdio.h>
import geometry;
// a namespace in a subdirectory is imported as `import a::b;` and is then
// called `b`. Any import can be renamed with `as`
import geometry as geo;

// there is no clash with geometry::area, the names of another namespace are
// only reachable through namespace::name. In the generated c code this one
// is called namespaces_area and the one from geometry/rect.tc is rect_area
int area(int side) {
    return side * side;
}

int main(void) {
    // things from a namespace are always written as namespace::name
    geometry::Point a = geometry::point(1, 2);
    geo::Point b = geo::point(4, 6);
    geo::Rect r = {a, b};

    // methods need no prefix, they come along with the type
    printf("%d\n", a.distance(b));
    printf("%d %d\n", geo::area(r), area(3));

    // only what is marked pub can be reached from here:
    // geo::abs_diff(1, 2) is "'abs_diff' is private to namespace 'geometry'"
}

// typedc transpiler will generate something like this:
//
// /* Generated by typedc. */
// #ifndef TYPEDC_NAMESPACES_H
// #define TYPEDC_NAMESPACES_H
//
// #include <stdio.h>
//
// typedef struct {
//     int x;
//     int y;
// } Point;
//
// typedef struct {
//     Point min;
//     Point max;
// } Rect;
//
// static inline Point point(int x, int y);
// static inline int abs_diff(int a, int b);
// static inline int point_length(Point from, Point to);
// static inline int rect_length(int from, int to);
// static inline int rect_area(Rect r);
// static inline int namespaces_area(int side);
// int main(void);
// static inline int distance(Point self, Point other);
//
// static inline Point point(int x, int y) {
//     Point p = {x, y};
//     return p;
// }
//
// static inline int abs_diff(int a, int b) {
//     return a > b ? a - b : b - a;
// }
//
// static inline int point_length(Point from, Point to) {
//     return abs_diff(from.x, to.x) + abs_diff(from.y, to.y);
// }
//
// static inline int rect_length(int from, int to) {
//     return abs_diff(from, to);
// }
//
// static inline int rect_area(Rect r) {
//     return rect_length(r.min.x, r.max.x) * rect_length(r.min.y, r.max.y);
// }
//
// static inline int namespaces_area(int side) {
//     return side * side;
// }
//
// int main(void) {
//     Point a = point(1, 2);
//     Point b = point(4, 6);
//     Rect r = {a, b};
//     printf("%d\n", distance(a, b));
//     printf("%d %d\n", rect_area(r), namespaces_area(3));
// }
//
// static inline int distance(Point self, Point other) {
//     return point_length(self, other);
// }
//
// #endif /* TYPEDC_NAMESPACES_H */
