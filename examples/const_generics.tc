#include <stdio.h>

typedef enum {
    SAY_HI,
    SAY_BYE,
} Choices;


// Const generics are essentially typed generic parameters, which you can set at
// transpile time, then when the c code is generated, each instanciation of some generic
// will create a separate version of a function/struct
void greet<Choices C>(char* name){
    if (!name) {
        name = "World";
    }
    // since the input is an constant, any compiler will simplify
    // this switch case at any optimisation level
    switch (C) {
        case SAY_HI: {
            printf("Hi, %s\n", name);
            break;
        }
        case SAY_BYE: {
            printf("Bye, %s\n", name);
            break;
        }
    }
}

// raw c, meaning just regular c, which typed c cannot handle
// such as macro definitions can be put inside #{}# blocks and this
// block will be copied over to the generated c code 1:1
#{
#define SAY_WHAT 0
}#

int main(void) {
    greet<Choices::SAY_HI>("Bob");
    // you can evaluate expressions in constant generics
    // you just need to put the expression in brackets
    greet<(SAY_WHAT ? Choices::SAY_HI : Choices::SAY_BYE)>(NULL);
}

