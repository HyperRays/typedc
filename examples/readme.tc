// Based off of simple_generics.tc
// ./build/main examples/readme.tc | cc -std=c11 -x c - -o build/readme

#include <stdio.h>
#include <complex.h>
import builtin;

// you can define your own operator in fortran .op. style with a trait
trait<T> DotP {
    // for parsing reasons any dot-op must have whitespaces around it in any context
    T .dot. (Self self, Self other);
}

// a trait for formatting
trait Display { int format(Self self, char* buf, int size);}
impl Display for float _Complex {
    int format(Self self, char* buf, int size) {
        return snprintf(buf, size, "%g + %gi", crealf(self), cimagf(self));
    }
}
impl Display for float {
    int format(Self self, char* buf, int size) {
        return snprintf(buf, size, "%g", self);
    }
}

// using a very similar syntax to rust, you can add generics to structs
typedef<T> struct {
    T x;
    T y;
    T z;
} Vector<T>;

// and by appling the trait to your struct (with generic parameters)
// you can define what your operator should do.
impl<T> DotP<T> for Vector<T> {
    T .dot. (Self self, Self other){
        return self.x * other.x + self.y * other.y + self.z * other.z;
    }
}

// Compile time code generation
impl<T: Display> Display for Vector<T> {
    int format(Self self, char* buf, int size) {
        int c = snprintf(buf, size, "%s { ", @name<Self>());
        // @ prefixed items are compile time constants, usable
        // in compile time code execution & generation
        // Here @int i and @count<Self> are used to unroll this for loop
        // at compile time
        for (@int i = 0; i < @count<Self>(); i++) {
            if (i)
                c += snprintf(buf+c, size-c, ", ");
            c += snprintf(buf+c, size-c, "%s: ", @fields<Self>()[i].name);
            // the abc.[...] syntax is used to define which
            // method you want to access programatically at compile time
            builtin::@Field f = @fields<Self>()[i];
            c += self.[f].format(buf+c, size-c);
        }
        c += snprintf(buf+c, size-c, " }");
        return c;
    }
}

int main(void) {
    // by concretly defining which type you want to use as the generic
    // a c struct with that/those type(s) is genenerated
    char buf[512];

    Vector<float> fv = {1.0, 2.0, 3.0};
    fv.format(buf, sizeof(buf));
    printf("%s\n", buf);
    printf("Dot product of fv^2: %g\n", fv .dot. fv);

    Vector<float _Complex> cv = {1.0fi, 2.0, 1.0fi};
    cv.format(buf, sizeof(buf));
    printf("%s\n", buf);

    (cv .dot. cv).format(buf, sizeof buf); // has a _Complex type as such cannot be directly printed
    printf("Dot product of iv^2: %s\n", buf);
}

// The program prints:

//> Vector { x: 1, y: 2, z: 3 }
//> Dot product of fv^2: 14
//> Vector { x: 0 + 1i, y: 2 + 0i, z: 0 + 1i }
//> Dot product of iv^2: 2 + 0i

