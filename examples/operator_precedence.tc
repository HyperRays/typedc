#include <stdio.h>

typedef struct {
    double x;
    double y;
} Vec2;

// by default a dotted operator binds tighter than every c operator and
// is left associative, so `a .dot. b + 1` is `(a .dot. b) + 1`.
// With @prec(left, right) you choose the binding powers yourself, higher
// binds tighter. The c operators use these:
//
//   =  += ...   4,  3        ==  !=        16, 17
//   ?:          5,  5        <  >  <= >=   18, 19
//   ||          6,  7        << >>         20, 21
//   &&          8,  9        +  -          22, 23
//   |          10, 11        *  /  %       24, 25
//   ^          12, 13        (no @prec)    26, 27
//   &          14, 15
//
// left < right makes the operator left associative,
// left > right makes it right associative
trait VecMath {
    // same as + and *, so the usual math rules apply
    @prec(22, 23)
    Self .add. (Self self, Self other);
    @prec(24, 25)
    Self .scale. (Self self, double factor);

    // no @prec, binds tightest
    double .dot. (Self self, Self other);

    // right associative, and looser than .add.
    @prec(21, 20)
    Self .or_else. (Self self, Self other);
}

impl VecMath for Vec2 {
    Self .add. (Self self, Self other) {
        Vec2 out = {self.x + other.x, self.y + other.y};
        return out;
    }

    Self .scale. (Self self, double factor) {
        Vec2 out = {self.x * factor, self.y * factor};
        return out;
    }

    double .dot. (Self self, Self other) {
        return self.x * other.x + self.y * other.y;
    }

    // the first vector which is not zero
    Self .or_else. (Self self, Self other) {
        return self.x != 0 || self.y != 0 ? self : other;
    }
}

int main(void) {
    Vec2 zero = {0, 0};
    Vec2 a = {1, 2};
    Vec2 b = {3, 4};

    // .scale. binds tighter than .add., like * and +
    Vec2 c = a .add. b .scale. 2;
    // brackets work as always
    Vec2 d = (a .add. b) .scale. 2;
    printf("%g %g\n", c.x, c.y);
    printf("%g %g\n", d.x, d.y);

    // a .dot. b is evaluated first, then the + 1
    printf("%g\n", a .dot. b + 1);

    // groups from the right: zero .or_else. (zero .or_else. (a .add. b))
    Vec2 e = zero .or_else. zero .or_else. a .add. b;
    printf("%g %g\n", e.x, e.y);
}

