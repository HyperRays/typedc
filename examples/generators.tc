// Generators: '@' functions that add declarations to the program.
// ./build/main examples/generators.tc | cc -std=c11 -x c - -o build/generators

#include <stdio.h>

trait Show { void show(Self self); }

impl Show for int { void show(Self self) { printf("%d", self); } }
impl Show for double { void show(Self self) { printf("%g", self); } }
impl Show for float { void show(Self self) { printf("%g", self); } }

typedef struct { int x; int y; } Point;
typedef struct { Point from; Point to; double width; } Line;
typedef<T> struct { T value; Tree<T>* left; Tree<T>* right; } Tree<T>;

// Inside an '@' function, `@emit` puts the declaration that follows into the
// program; everything else in the function is its own. What is emitted can use
// the function's generic arguments and variables, with the values they have at
// that moment.
//
// An emitted item belongs where the generator is used, and reads names as the
// code there does. So a generator is self-contained: what its items need from
// elsewhere, it imports and includes in its own body. Nothing else of the file
// it is written in reaches them.
void @derive_show<T>() {
    #include <stdio.h>
    import builtin;

    // A generator looks at the program and decides for itself what to do.
    // @implements is true as soon as the implementation exists, whether it was
    // written by hand or emitted, in whatever order the generators run.
    if (@implements<T, Show>()) return;

    if (@kind<T>() == builtin::FieldKind::FIELD_POINTER) {
        @emit impl Show for T {
            void show(Self self) {
                if (self) (*self).show();
                else printf("null");
            }
        }
        @derive_show<@pointee<T>()>();
        return;
    }

    // The item exists from here on. Its body is worked out later, when the
    // implementations it calls exist as well.
    @emit impl Show for T {
        void show(Self self) {
            printf("%s { ", @name<T>());
            for (@int i = 0; i < @count<T>(); i++) {
                builtin::@Field f = @fields<T>()[i];
                if (i) printf(", ");
                printf("%s: ", f.name);
                self.[f].show();
            }
            printf(" }");
        }
    }

    // Emitted first, so a type that contains itself ends: when the function
    // comes to Tree again, Tree already implements Show.
    for (int i = 0; i < @count<T>(); i++)
        @derive_show<@fields<T>()[i].type>();
}

// An '@' call at file scope starts a generator. Its items are declared here,
// in the file that starts it, which is where `Show` is looked up.
@derive_show<Line>();
for<T> @derive_show<Tree<T>>();

// Any declaration can be emitted, and '@' functions take ordinary arguments.
// Items of one generator see each other: they are declared side by side.
void @counter(const char* label, int start) {
    #include <stdio.h>
    @emit static int count = start;
    @emit int next(void) {
        printf("%s %d\n", label, count);
        return count++;
    }
}

@counter("ticket", 100);

int main(void) {
    Line l = {{1, 2}, {3, 4}, 0.5};
    Tree<float> leaf = {2, 0, 0};
    Tree<float> root = {1, &leaf, 0};
    l.show();
    printf("\n");
    root.show();
    printf("\n");
    next();
    next();
    return 0;
}

//> Line { from: Point { x: 1, y: 2 }, to: Point { x: 3, y: 4 }, width: 0.5 }
//> Tree { value: 1, left: Tree { value: 2, left: null, right: null }, right: null }
//> ticket 100
//> ticket 101

