#include <stdio.h>
import builtin;

// Reflection is something you ask for, at the place where you want the table.
// builtin::fields_of<T>(), builtin::enum_names<T>() and
// builtin::generics_of<T>() look like calls, but stand for the
// initializer list you would otherwise write and keep up to date by hand.
// builtin::name_of<T>() gives you a NameInfo value where `.name` is the source name without
// generic arguments, and `.mangled` is the final identifier used in the emitted C.
// These can be the same when the source name has no collisions.
// builtin::kind_of<T>() gives a FieldKind enumerator, using the same kinds as fields_of.

typedef enum {
    IDLE,
    RUNNING,
    STOPPED = 5,
} State;

typedef struct {
    int id;
    double load;
    char* name;
    State state;
} Task;

// indexed by value, so state_names[STOPPED] works
// and the gap between RUNNING and STOPPED is NULL
static const char* const state_names[] = builtin::enum_names<State>();

// static const char* const state_names[] = {
//     [IDLE] = "IDLE",
//     [RUNNING] = "RUNNING",
//     [STOPPED] = "STOPPED",
// };

// The pointer supplies T, so callers do not need to construct a field table.
// Each entry records the name, type, offset, size, bit-field width and kind.
void print_fields<T>(T* value) {
    static const builtin::FieldInfo fields[] = builtin::fields_of<T>();
    printf("  C type: %s\n", builtin::name_of<T>().mangled);
    const char* base = (const char*)value;
    for (size_t i = 0; i < sizeof fields / sizeof fields[0]; i++) {
        const builtin::FieldInfo* f = &fields[i];
        const void* at = base + f->offset;
        printf("  %-6s %-7s ", f->name, f->type);
        switch (f->kind) {
            case builtin::FieldKind::FIELD_INT:     printf("%d\n", *(const int*)at); break;
            case builtin::FieldKind::FIELD_FLOAT:   printf("%g\n", *(const float*)at); break;
            case builtin::FieldKind::FIELD_DOUBLE:  printf("%g\n", *(const double*)at); break;
            case builtin::FieldKind::FIELD_POINTER: printf("%p\n", *(void* const*)at); break;
            case builtin::FieldKind::FIELD_ENUM:    printf("%s\n", state_names[*(const State*)at]); break;
            default:            printf("(%zu bytes)\n", f->size); break;
        }
    }
}

// For Task, fields_of<T>() generates:
// static const FieldInfo fields[] = {
//     {"id", "int", offsetof(Task, id), sizeof(int), 0, FIELD_INT},
//     {"load", "double", offsetof(Task, load), sizeof(double), 0, FIELD_DOUBLE},
//     {"name", "char*", offsetof(Task, name), sizeof(char*), 0, FIELD_POINTER},
//     {"state", "State", offsetof(Task, state), sizeof(State), 0, FIELD_ENUM},
// };

// T is the pointee type: a struct for a data pointer, or the signature for a
// function pointer. Reflecting describe<T> exposes that inferred type in args[0].
// name_of describes this helper specialization, including its generated C name.
void describe<T>(T* value) {
    (void)value;
    static const builtin::GenericInfo args[] = builtin::generics_of<describe<T>>();
    static const builtin::NameInfo function = builtin::name_of<describe<T>>();
    const builtin::FieldKind kind = builtin::kind_of<T*>();
    printf("%s:\n", args[0].type);
    printf("  kind: %s\n", kind == builtin::FieldKind::FIELD_FUNCTION_POINTER
           ? "function pointer" : "data pointer");
    printf("  %s specialization: %s\n", function.name, function.mangled);
}

// GenericInfo records each parameter's name and the argument bound to it.
// Type arguments have a NULL value. Constant arguments have their declared type
// and a value string: a number when evaluated, otherwise the C expression.
// For example, generics_of<Unit<10>>() produces {"T", "int", "10"}, while
// generics_of<describe<Unit<10>>>() produces {"T", "Unit<10>", NULL}.

typedef<int T> struct {} Unit<T>;


typedef<T> struct {
    T min;
    T max;
} Range<T>;

T identity<T>(T value) {
    return value;
}

int main(void) {
    Task t = {7, 0.25, "build", STOPPED};
    describe(&t);
    print_fields(&t);

    Range<float> r = {1.0, 10.1};
    describe(&r);
    print_fields(&r);
    Range<int> integers = {1, 10};
    describe(&integers);
    print_fields(&integers);

    Unit<10> unit = {};
    describe(&unit);
    print_fields(&unit);

    // The same describe infers the signature from a stored function pointer.
    int (*callback)(int) = identity<int>;
    describe(callback);
    double (*other_callback)(double) = identity<double>;
    describe(other_callback);
}

