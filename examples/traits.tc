#include <stdio.h>
#include <string.h>

// a trait is a list of methods (or operators) which a type can implement
trait Show {
    void show(Self self);
}

// traits can be implemented for any type: builtin ones, pointers
// and your own structs
impl Show for int {
    void show(Self self) { printf("%d", self); }
}

impl Show for char* {
    void show(Self self) { printf("\"%s\"", self); }
}

typedef struct {
    int x;
    int y;
} Point;

impl Show for Point {
    void show(Self self) { printf("(%d, %d)", self.x, self.y); }
}

// `T: Show` is a bound, this function only accepts types which implement
// Show and in return it is allowed to call .show() on a T.
// Calling it with e.g. a double* is an error at the call, not somewhere
// inside of the generated c code
void show_all<T: Show>(T* items, int count) {
    printf("[");
    for (int i = 0; i < count; i++) {
        if (i) printf(", ");
        items[i].show();
    }
    printf("]\n");
}

trait Order {
    int .before. (Self self, Self other);
}

impl Order for int {
    int .before. (Self self, Self other) { return self < other; }
}

impl Order for char* {
    int .before. (Self self, Self other) { return strcmp(self, other) < 0; }
}

// multiple bounds are joined with +
T smallest<T: Order + Show>(T* items, int count) {
    T best = items[0];
    for (int i = 1; i < count; i++) {
        if (items[i] .before. best) best = items[i];
    }
    printf("smallest of ");
    show_all(items, count);
    return best;
}

int main(void) {
    int numbers[] = {3, 1, 2};
    char* words[] = {"pear", "apple", "plum"};
    Point points[] = {{0, 0}, {1, 2}};

    show_all(points, 2);
    smallest(numbers, 3).show();
    printf("\n");
    smallest(words, 3).show();
    printf("\n");
}

