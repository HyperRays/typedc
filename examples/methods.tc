#include <stdio.h>

typedef struct {
    int value;
    int step;
} Counter;

// an impl block adds methods to a type.
// for a method the first parameter is always the receiver `self`,
// and inside of an impl block `Self` is the type which the block is for
// So in this case Self == Counter
impl Counter {
    int next(Self self) {
        return self.value + self.step;
    }
}

// the receiver is passed like any other c argument, so by value.
// A method which should change the receiver has to be written for the
// pointer type instead, here Self == Counter*
impl Counter* {
    void tick(Self self) {
        self->value += self->step;
    }
}

// impl blocks take generic parameters just like structs do
typedef<T> struct {
    T first;
    T second;
} Pair<T>;

impl<T> Pair<T> {
    Pair<T> flipped(Self self) {
        Pair<T> out = {self.second, self.first};
        return out;
    }
}

// any type can get methods, also the builtin ones
impl int {
    int squared(Self self) {
        return self * self;
    }
}

int main(void) {
    Counter c = {0, 5};

    // methods are looked up on the exact type of the receiver, there is no
    // automatic & or *. So c.tick() is an error (Counter has no tick),
    // you call it on a Counter*
    (&c).tick();
    Counter* p = &c;
    p.tick();
    printf("%d %d\n", c.value, c.next());

    Pair<char> ab = {'a', 'b'};
    printf("%c\n", ab.flipped().first);

    int n = 4;
    printf("%d %d\n", n.squared(), (3).squared());
}

