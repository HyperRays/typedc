#include <stdio.h>
#include <stddef.h>

// Const generics also work on structs
typedef<T, size_t N> struct {
    T items[N];
} Row<T, N>;

// N is inferred from the argument together with T, and inside of the
// function it is a constant, so the c compiler knows the loop bounds
T sum<T, size_t N>(Row<T, N> row) {
    T total = 0;
    for (size_t i = 0; i < N; i++) {
        total += row.items[i];
    }
    return total;
}

// the size of the result can be computed from the sizes of the arguments
Row<T, A + B> join<T, size_t A, size_t B>(Row<T, A> left, Row<T, B> right) {
    Row<T, A + B> out;
    for (size_t i = 0; i < A; i++) out.items[i] = left.items[i];
    for (size_t i = 0; i < B; i++) out.items[A + i] = right.items[i];
    return out;
}

Row<T, K> take<T, size_t N, size_t K>(Row<T, N> row) {
    _Static_assert(K <= N, "cannot take more items than the row has");
    Row<T, K> out;
    for (size_t i = 0; i < K; i++) out.items[i] = row.items[i];
    return out;
}

#{#define WIDTH 3}#

int main(void) {
    Row<int, 2> a = {{1, 2}};
    // any constant expression can be a size
    Row<int, WIDTH> b = {{3, 4, 5}};

    // Row<int, 2> joined with Row<int, 3> is a Row<int, 5>.
    // Assigning it to a Row<int, 4> does not compile, in the generated
    // c code those are two different structs
    Row<int, 5> all = join(a, b);
    // sizes are compared by value, this is the same type as Row<int, 5>
    Row<int, 2 + WIDTH> same = all;

    Row<int, 2> head = take(all);
    printf("%d %d %d\n", sum(all), sum(same), sum(head));
}

